# Copia este archivo como .env.local para compilar en tu computador.
# En Vercel se configuran en: Project → Settings → Environment Variables.

# URL del proyecto: Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave PÚBLICA: "anon public" (JWT) o "publishable" (sb_publishable_...).
# NUNCA uses aquí la service_role / secret key: el build se detiene si lo intentas.
SUPABASE_ANON_KEY=

# Opcional: correo que aparece pre-escrito en el login del panel (queda visible públicamente en config.js)
ADMIN_EMAIL=
